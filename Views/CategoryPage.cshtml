@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.CategoryPage>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = "./Shared/_Layout.cshtml";
	int mobileBreak = 720;

	List<ProductCategory>? categories = Model?.Descendants<ProductCategory>().ToList();
	List<Product>? products = Model?.Descendants<Product>().ToList();
	List <ProductTag> tags = new List<ProductTag>();

	if (products != null && products.Any())
	{
		foreach (Product product in products)
		{
			if (product.Tag != null && product.Tag.Any())
			{
				foreach (ProductTag tag in product.Tag)
				{
					tags.Add(tag);
				}
			}
		}
		tags = tags.Distinct().ToList();
	}
}
<partial name="./Partials/singleblock/Components/HeroBlock.cshtml" model="@Model?.Hero?.Content" />
<partial name="./Partials/_Breadcrumbs.cshtml" model="@Model" />

<section id="store" x-data="storeFilter">
	<section class="container container--split"
		x-init="open = window.innerWidth > @mobileBreak">
		<aside 
			class="container__aside store__filter"
			@@resize.window="open = window.innerWidth > @mobileBreak">
			@{
				ViewData["categories"] = categories;
				ViewData["tags"] = tags;
			}
			<partial name="./Partials/_Store-filter.cshtml" model="@Model" />
		</aside>
		<div class="container__content store__section store__section--products">
			<ul class="grid grid--3 mix-container">
				@foreach (Product product in products ?? Enumerable.Empty<Product>())
				{
					<partial name="./Partials/_GridCardStore.cshtml" model="@product" />
				}
			</ul>
		</div>
	</section>
</section>

@Html.GetBlockListHtml(Model?.BlockList)